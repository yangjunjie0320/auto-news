.DS_Store

# 抓取端运行时产物
scraper/state/
scraper/logs/
scraper/config.yaml
scraper/.venv/
scraper/.python-version.local

# 网站构建产物
web/node_modules/
web/.next/
web/out/
web/next-env.d.ts
web/*.tsbuildinfo

# 全局 ~/.gitignore 的 lib/ 规则会误伤源码目录 web/src/lib/，这里放行
!web/src/lib/
# CLAUDE.md 与 .claude/ 由全局 ~/.gitignore 排除，是有意的：
# 这些是本地的 agent 配置，不入库、不公开。不要在这里加 ! 放行。

# 部署配置含密钥
deploy/config.yaml
